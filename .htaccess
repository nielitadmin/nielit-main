<IfModule mod_rewrite.c>
    RewriteEngine On

    # Omit RewriteBase so Apache uses the folder URL (/public_html/ locally, / on production).
    # Do NOT set RewriteBase / when the app runs in a subdirectory on XAMPP.

    # Optional HTTPS redirect (uncomment on production if not handled by host panel)
    # RewriteCond %{HTTPS} off
    # RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

    # Block direct web access to sensitive directories
    RewriteRule ^(?:config|includes|migrations|libraries)(?:/|$) - [F,L]

    # Block Google OAuth credential JSON if accidentally placed in web root
    RewriteRule ^client_secret_.*\.json$ - [F,L]

    # Serve existing files and directories as-is
    RewriteCond %{REQUEST_FILENAME} -f [OR]
    RewriteCond %{REQUEST_FILENAME} -d
    RewriteRule ^ - [L]

    # Redirect visible .php URLs to extensionless equivalents (skip POST forms)
    RewriteCond %{ENV:REDIRECT_STATUS} ^$
    RewriteCond %{REQUEST_METHOD} !POST
    RewriteCond %{THE_REQUEST} \s/+index\.php[\s?] [NC]
    RewriteRule ^ / [R=301,L]

    RewriteCond %{ENV:REDIRECT_STATUS} ^$
    RewriteCond %{REQUEST_METHOD} !POST
    RewriteCond %{THE_REQUEST} \s/+(.+?)\.php[\s?] [NC]
    RewriteRule ^ %1 [R=301,L,NE,QSA]

    # Internally map /path to /path.php when the file exists
    RewriteCond %{REQUEST_FILENAME}.php -f
    RewriteRule ^(.+?)/?$ $1.php [L,QSA]
</IfModule>

DirectoryIndex index.php index.html
Options -Indexes

# Upload limits (adjust if your host allows php_value in .htaccess)
# post_max_size must cover ALL files in one registration submit
<IfModule mod_php.c>
    php_value upload_max_filesize 10M
    php_value post_max_size 64M
    php_value max_execution_time 300
    php_value max_input_time 300
    php_value memory_limit 256M
</IfModule>
<IfModule mod_php7.c>
    php_value upload_max_filesize 10M
    php_value post_max_size 64M
    php_value max_execution_time 300
    php_value max_input_time 300
    php_value memory_limit 256M
</IfModule>
<IfModule mod_php8.c>
    php_value upload_max_filesize 10M
    php_value post_max_size 64M
    php_value max_execution_time 300
    php_value max_input_time 300
    php_value memory_limit 256M
</IfModule>
