									"});",
									"",
									"pm.test(\"All students have passwords\", function () {",
									"    var jsonData = pm.response.json();",
									"    jsonData.data.students.forEach(function(student) {",
									"        pm.expect(student).to.have.property('password');",
									"        pm.expect(student.password).to.be.a('string');",
									"        pm.expect(student.password.length).to.be.greaterThan(10);",
									"    });",
