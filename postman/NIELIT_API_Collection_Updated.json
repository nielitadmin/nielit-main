		{
			"name": "Authentication",
			"item": [
				{
					"name": "Student Login - POST",
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"pm.test(\"Status code is 200\", function () {",
									"    pm.response.to.have.status(200);",
									"});",
									"",
									"pm.test(\"Response has token\", function () {",
									"    var jsonData = pm.response.json();",
									"    pm.expect(jsonData.data).to.have.property('token');",
									"    pm.environment.set('auth_token', jsonData.data.token);",
									"});",
									"",
									"pm.test(\"Response has student data\", function () {",
									"    var jsonData = pm.response.json();",
									"    pm.expect(jsonData.data).to.have.property('student');",
									"    pm.expect(jsonData.data.student).to.have.property('student_id');",
									"    pm.expect(jsonData.data.student).to.have.property('email');",
									"});"
								],
								"type": "text/javascript"
							}
						}
					],
					"request": {
						"method": "POST",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json"
							},
							{
								"key": "X-API-Key",
								"value": "{{api_key}}"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n    \"username\": \"{{test_student_id}}\",\n    \"password\": \"{{test_password}}\"\n}"
						},
						"url": {
							"raw": "{{base_url}}/api/v1/auth.php",
							"host": [
								"{{base_url}}"
							],
							"path": [
								"api",
								"v1",
								"auth.php"
							]
						},
						"description": "Authenticate a student using student_id and password"
					},
					"response": []
				},
