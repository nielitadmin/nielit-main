				{
					"name": "🔐 Get All Students with Passwords",
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"pm.test(\"Status code is 200\", function () {",
									"    pm.response.to.have.status(200);",
									"});",
									"",
									"pm.test(\"Response has students array\", function () {",
									"    var jsonData = pm.response.json();",
									"    pm.expect(jsonData.data).to.have.property('students');",
									"    pm.expect(jsonData.data.students).to.be.an('array');",
									"});",
									"",
									"pm.test(\"Students have password field\", function () {",
									"    var jsonData = pm.response.json();",
									"    if (jsonData.data.students.length > 0) {",
									"        var student = jsonData.data.students[0];",
									"        pm.expect(student).to.have.property('student_id');",
									"        pm.expect(student).to.have.property('email');",
									"        pm.expect(student).to.have.property('name');",
									"        pm.expect(student).to.have.property('password');",
									"        pm.expect(student.password).to.be.a('string');",
									"        pm.expect(student.password.length).to.be.greaterThan(10);",
									"    }",
									"});",
									"",
									"pm.test(\"Response includes security warning\", function () {",
									"    var jsonData = pm.response.json();",
									"    pm.expect(jsonData.data).to.have.property('warning');",
									"    pm.expect(jsonData.data.warning).to.include('password');",
									"});",
									"",
									"pm.test(\"Response has pagination info\", function () {",
									"    var jsonData = pm.response.json();",
									"    pm.expect(jsonData.data).to.have.property('pagination');",
									"    pm.expect(jsonData.data.pagination).to.have.property('total');",
									"});",
									"",
									"pm.test(\"Password hash format is correct\", function () {",
									"    var jsonData = pm.response.json();",
									"    if (jsonData.data.students.length > 0) {",
									"        var student = jsonData.data.students[0];",
									"        // Check if password looks like a bcrypt hash",
									"        pm.expect(student.password).to.match(/^\\$2[ayb]\\$.{56}$/);",
									"    }",
									"});"
								],
								"type": "text/javascript"
							}
						}
					],
