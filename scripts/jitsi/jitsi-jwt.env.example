# Add these lines to /opt/jitsi-meet/.env on your GCP VM
# Must match includes/online_class_config.local.php on the portal

ENABLE_AUTH=1
JWT_APP_ID=nielit_portal
JWT_APP_SECRET=CHANGE_ME_TO_A_LONG_RANDOM_SECRET
JWT_ACCEPTED_ISSUERS=nielit_portal
JWT_ACCEPTED_AUDIENCES=jitsi
JWT_ALLOW_EMPTY=0
TOKEN_AUTH_URL=https://meet.nielitbhubaneswar.in

# After editing .env:
# cd /opt/jitsi-meet && docker compose down && docker compose up -d
