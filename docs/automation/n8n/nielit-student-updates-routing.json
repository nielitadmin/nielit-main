      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "const item = $input.first().json;\nconst body = item.body && typeof item.body === 'object' ? item.body : item;\nconst action = String(body.action || '').toLowerCase();\nconst urgent = ['student_inspector_purge', 'student_delete', 'student_inspector_delete'];\nconst bulk = ['student_excel_update', 'student_list_import'];\nlet route = 'normal';\nif (urgent.includes(action)) route = 'urgent';\nelse if (bulk.includes(action)) route = 'bulk';\nconst student = body.entity_id || body.entity_name || '(unknown)';\nconst desc = body.description || action;\nconst by = body.actor_name || body.actor_role || 'Admin';\nconst source = (body.details && body.details.source) ? body.details.source : '';\nconst when = body.created_at || new Date().toISOString();\nreturn [{ json: { ...body, route, student, desc, by, source, when } }];"
      },
      "id": "a1b2c3d4-code-route-003",
      "name": "Classify Route",
      "type": "n8n-nodes-base.code",
