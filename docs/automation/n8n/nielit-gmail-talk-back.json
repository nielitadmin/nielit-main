      "id": "http-feed-006",
      "name": "Fetch Activity",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [1260, 120]
    },
    {
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "const staticData = $getWorkflowStaticData('global');\nconst mail = $('Gmail Trigger').first().json;\nconst resp = $input.first().json;\nconst data = resp.data || resp;\nconst events = data.events || [];\nstaticData.sinceId = data.next_since_id ?? staticData.sinceId ?? 0;\nlet lines = events.map(e => `- ${e.created_at} | ${e.action} | ${e.entity_id || ''} | ${e.description || ''}`);\nif (lines.length === 0) lines = ['(No new student events in this window.)'];\nconst reply = `Hi,\\n\\nHere is your student activity report (${events.length} events):\\n\\n${lines.join('\\n')}\\n\\nReply anytime — say hello, or subject REPORT again later.\\n\\n— NIELIT Email Assistant (n8n)`;\nconst msgId = mail.id || mail.messageId;\nconst from = (mail.from && mail.from.value && mail.from.value[0]) ? mail.from.value[0].address : 'saswatsomya111@gmail.com';\nreturn [{ json: { reply, messageId: msgId, to: from } }];"
      },
      "id": "code-report-007",
      "name": "Build Report Reply",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [1500, 120]
    },
    {
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "const mail = $input.first().json;\nconst msg = String(mail.textPlain || mail.snippet || '').trim();\nconst subj = String(mail.subject || '').trim();\nconst lower = (subj + ' ' + msg).toLowerCase();\n\nlet reply = `Hi,\\n\\nI read your email. You wrote:\\n\"${msg.slice(0, 600).replace(/\"/g, \"'\")}\"\\n\\n`;\n\nif (/^(hi|hello|namaste|hey|good morning|good evening)\\b/i.test(msg) || msg.length < 20) {\n  reply += `I'm your NIELIT automation mailbox (n8n), not a human — but I do reply.\\n\\nTry:\\n• Subject or body: REPORT — recent student changes from the portal\\n• Ask: \"webhook\" — where to check if alerts are working\\n• For ChatGPT-style talk: enable the OpenAI node (see docs/automation/n8n/README.md)\\n\\nI cannot edit students by email — only the admin portal / Inspector can.\\n`;\n} else if (lower.includes('webhook') || lower.includes('n8n') || lower.includes('connect')) {\n  reply += `Webhook (portal → n8n):\\nhttps://nielitbbsr.app.n8n.cloud/webhook/nielit-student-updates\\n\\nOpen workflow \"NIELIT Student Update Notifications\" → Executions to see live runs. Portal: API & Automation → instant webhook ON.\\n`;\n} else if (lower.includes('help') || lower.includes('kya kar') || lower.includes('what can')) {\n  reply += `What I can do by email:\\n1) REPORT — student activity list\\n2) Explain webhook / n8n status\\n3) With OpenAI connected: free-form chat about your setup\\n\\nWhat I cannot do: change Narender/Narendra or any student — use Manage Students or Inspector Excel.\\n`;\n} else {\n  reply += `I'm on \"simple reply\" mode. For a longer conversation, either:\\n• Email subject REPORT for data, or\\n• In n8n, connect OpenAI to this workflow and turn on the AI branch.\\n\\nTell me hello or help if you're stuck.\\n`;\n}\n\nreply += `\\n— NIELIT Email Assistant (n8n)`;\n\nconst msgId = mail.id || mail.messageId;\nconst from = (mail.from && mail.from.value && mail.from.value[0]) ? mail.from.value[0].address : 'saswatsomya111@gmail.com';\nreturn [{ json: { reply, messageId: msgId, to: from } }];"
      },
